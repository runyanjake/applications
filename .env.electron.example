# Electron desktop app config. Copy these into .env (electron-vite loads it).
# Values are inlined into the build at build time — rebuild after changing them.

# "Desktop app" OAuth client from GCP Console (Google Auth Platform > Clients).
# Desktop clients use loopback redirects, so no redirect URIs need registering.
# The secret is not treated as confidential for desktop clients.
MAIN_VITE_GOOGLE_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
MAIN_VITE_GOOGLE_CLIENT_SECRET=your-desktop-client-secret
