# Google OAuth client ID and API key from the Google Cloud console.
# Both are inlined into the bundle at build time.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-api-key

# Hostname Traefik routes to this container (production only).
DOMAIN=apps.example.com

# Log sink (production only).
# Host directory the rotating log files are written to.
LOG_DIR=/pwspool/software/applications/logs
# How long to keep log files, and how often to start a new one.
LOG_RETENTION=30d
LOG_ROTATE_FREQUENCY=1d
LOG_LEVEL=info
# Console output format for `docker logs`: "pretty" (human) or "json" (collectors).
LOG_CONSOLE_FORMAT=pretty
